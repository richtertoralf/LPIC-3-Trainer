# LPIC-3 Trainer configuration (systemd EnvironmentFile). Copy lives in /etc/lpic3-trainer/.
LPIC3_HOST=127.0.0.1
LPIC3_PORT=8000
LPIC3_DATA_DIR=/var/lib/lpic3-trainer
# Set to true when served through an HTTPS reverse proxy.
LPIC3_SECURE_COOKIES=false
# Session lifetime in hours (default 720 = 30 days).
LPIC3_SESSION_HOURS=720
LPIC3_LOG_LEVEL=info
# Exam simulation: question count and minutes for a full module.
LPIC3_EXAM_QUESTIONS=60
LPIC3_EXAM_MINUTES=90
LPIC3_TOPIC_EXAM_QUESTIONS=15
LPIC3_ENTRY_QUESTIONS=10
# Password policy: length limits only (defaults 8 and 128, allowed 1 to 1024).
# Existing passwords stay valid when the limits change.
LPIC3_PASSWORD_MIN_LENGTH=8
LPIC3_PASSWORD_MAX_LENGTH=128
