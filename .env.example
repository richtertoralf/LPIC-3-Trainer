# Development configuration. Copy to .env and export, or set the variables in your shell.
LPIC3_HOST=127.0.0.1
LPIC3_PORT=8000
LPIC3_DATA_DIR=./data
LPIC3_SECURE_COOKIES=false
LPIC3_SESSION_HOURS=720
LPIC3_LOG_LEVEL=info
LPIC3_EXAM_QUESTIONS=60
LPIC3_EXAM_MINUTES=90
LPIC3_TOPIC_EXAM_QUESTIONS=15
LPIC3_ENTRY_QUESTIONS=10
